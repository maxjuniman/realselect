generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Season {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  year      Int
  half      Int
  isCurrent Boolean @default(false)
  matches   Match[]
}

model Player {
  id          String            @id @default(cuid())
  name        String            @unique
  active      Boolean           @default(true)
  guest       Boolean           @default(false)
  squad       String            @default("mensalista")
  positions   String[]          @default([])
  appearances MatchAppearance[]
  events      MatchEvent[]
  professorOf Match[]           @relation("Professor")
  createdAt   DateTime          @default(now())
}

model Match {
  id          String            @id @default(cuid())
  seasonId    String
  season      Season            @relation(fields: [seasonId], references: [id])
  playedOn    DateTime
  scoreA      Int?
  scoreB      Int?
  goalDiffA   Int
  scoreLabel  String?
  professorId String?
  professor   Player?           @relation("Professor", fields: [professorId], references: [id])
  origin      String            @default("manual")
  appearances MatchAppearance[]
  events      MatchEvent[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([seasonId, playedOn])
  @@index([playedOn])
}

model MatchAppearance {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  team     String

  @@unique([matchId, playerId])
  @@index([playerId])
}

model MatchEvent {
  id       String  @id @default(cuid())
  matchId  String
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String?
  player   Player? @relation(fields: [playerId], references: [id])
  type     String
  count    Int     @default(1)

  @@index([matchId])
  @@index([playerId])
}
