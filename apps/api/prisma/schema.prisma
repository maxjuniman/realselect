generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Season {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  year      Int
  half      Int
  isCurrent Boolean @default(false)
  matches   Match[]
}

model Player {
  id          String            @id @default(cuid())
  name         String            @unique
  nickname     String?
  birthDate    DateTime?
  photo        String?
  active       Boolean           @default(true)
  guest        Boolean           @default(false)
  squad        String            @default("mensalista")
  injured      Boolean           @default(false)
  positions    String[]          @default([])
  appearances   MatchAppearance[]
  events        MatchEvent[]
  professorOf   Match[]           @relation("Professor")
  professorTurn ProfessorTurn?
  absences      GameAbsence[]
  professorPlans ProfessorPlan[]
  account        PlayerAccount?
  votesCast      MatchVote[]       @relation("VoteVoter")
  craqueVotes    MatchVote[]       @relation("VoteCraque")
  perebaVotes    MatchVote[]       @relation("VotePereba")
  createdAt      DateTime          @default(now())
}

model PlayerAccount {
  id           String    @id @default(cuid())
  name         String
  birthDate    DateTime?
  passwordHash String
  access       String    @default("pending")
  playerId     String?   @unique
  player       Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
}

model ProfessorTurn {
  playerId String @id
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sort     Int

  @@index([sort])
}

model GameAbsence {
  playedOn DateTime
  playerId String
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playedOn, playerId])
}

model ProfessorPlan {
  playedOn  DateTime @id
  playerId  String
  cancelled Boolean  @default(false)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Match {
  id          String            @id @default(cuid())
  seasonId    String
  season      Season            @relation(fields: [seasonId], references: [id])
  playedOn    DateTime
  scoreA      Int?
  scoreB      Int?
  goalDiffA   Int
  scoreLabel  String?
  professorId String?
  professor   Player?           @relation("Professor", fields: [professorId], references: [id])
  origin      String            @default("manual")
  scheduled   Boolean           @default(false)
  colorA      String            @default("verde")
  appearances MatchAppearance[]
  events      MatchEvent[]
  votes       MatchVote[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([seasonId, playedOn])
  @@index([playedOn])
}

model MatchAppearance {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  team     String

  @@unique([matchId, playerId])
  @@index([playerId])
}

model MatchVote {
  matchId   String
  voterId   String
  craqueId  String
  perebaId  String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  voter     Player   @relation("VoteVoter", fields: [voterId], references: [id], onDelete: Cascade)
  craque    Player   @relation("VoteCraque", fields: [craqueId], references: [id], onDelete: Cascade)
  pereba    Player   @relation("VotePereba", fields: [perebaId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@id([matchId, voterId])
}

model MatchEvent {
  id       String  @id @default(cuid())
  matchId  String
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String?
  player   Player? @relation(fields: [playerId], references: [id])
  type     String
  count    Int     @default(1)

  @@index([matchId])
  @@index([playerId])
}
